{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KayzenRoot/uads/schemas/github-review-index.schema.json",
  "title": "UADS canonical GitHub review index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "repository", "version", "commitSha", "gitTreeSha", "ciRunId", "ciRunAttempt", "directReviewRunId", "directReviewArtifactName", "directReviewEvidenceSha256", "codeqlRunId", "codeqlStatus", "scorecardRunId", "scorecardStatus", "releaseRunId", "tag", "expectedTagTargetSha", "releaseAssetNames"],
  "properties": {
    "schema": { "const": "uads.github-review-index" }, "schemaVersion": { "enum": ["0.8.0", "0.9.0"] },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "gitTreeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ciRunId": { "type": ["integer", "null"], "minimum": 1 }, "ciRunAttempt": { "type": ["integer", "null"], "minimum": 1 },
    "directReviewRunId": { "type": ["integer", "null"], "minimum": 1 },
    "directReviewArtifactName": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240 },
    "directReviewEvidenceSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "codeqlRunId": { "type": ["integer", "null"], "minimum": 1 }, "codeqlStatus": { "type": "string", "enum": ["success", "failure", "cancelled", "skipped", "pending", "unavailable", "not-evaluated-here", "unknown"] },
    "scorecardRunId": { "type": ["integer", "null"], "minimum": 1 }, "scorecardStatus": { "type": "string", "enum": ["success", "failure", "cancelled", "skipped", "pending", "unavailable", "not-evaluated-here", "unknown"] },
    "releaseRunId": { "type": ["integer", "null"], "minimum": 1 }, "tag": { "type": "string", "pattern": "^v[0-9]" }, "expectedTagTargetSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "releaseAssetNames": { "type": "array", "maxItems": 128, "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240 } },
    "securityProofs": { "$ref": "#/$defs/securityProofs" }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "0.9.0" } } },
      "then": { "required": ["securityProofs"] }
    }
  ],
  "$defs": {
    "securityProof": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow", "proofMode", "outcome", "repository", "event", "headBranch", "baseRepository", "baseRef", "sourceBranch", "finalCommitSha", "finalTreeSha", "sourceCommitSha", "sourceTreeSha", "runId", "runAttempt", "pullRequestNumber", "htmlUrl", "proofDigest"],
      "properties": {
        "workflow": { "enum": ["codeql", "scorecard", "dependency-review"] },
        "proofMode": { "enum": ["exact-sha", "same-tree-pr"] },
        "outcome": { "enum": ["success", "failure", "cancelled", "skipped", "unknown"] },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "event": { "type": "string", "pattern": "^[a-z0-9_-]{1,80}$" },
        "headBranch": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]{1,255}$" },
        "baseRepository": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "baseRef": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]{1,255}$" },
        "sourceBranch": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._/-]{1,255}$" },
        "finalCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "finalTreeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceTreeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 },
        "htmlUrl": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+$" },
        "proofDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "securityProofs": {
      "type": "object", "additionalProperties": false,
      "required": ["codeql", "scorecard", "dependencyReview"],
      "properties": {
        "codeql": { "$ref": "#/$defs/securityProof" },
        "scorecard": { "$ref": "#/$defs/securityProof" },
        "dependencyReview": { "$ref": "#/$defs/securityProof" }
      }
    }
  }
}
