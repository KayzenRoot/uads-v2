{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/gef-context-slice.schema.json",
  "title": "GEF Context Slice",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "radius", "compilerVersion", "producerVersion", "toolchainBasis", "architectureBasis", "entries", "expansions", "sliceDigest"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "taskId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "radius": { "type": "string", "enum": ["C0", "C1", "C2", "C3", "C4"] },
    "compilerVersion": { "type": "string", "const": "1.0.0" },
    "producerVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "toolchainBasis": { "type": "string", "minLength": 1, "maxLength": 200 },
    "architectureBasis": { "type": "string", "enum": ["NONE", "EXPLICIT", "PROFILE", "UADS_FALLBACK"] },
    "entries": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "symbol", "kind", "contentDigest", "signatures", "dependencies", "tests", "invariants", "fallback", "inclusionReason"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 300 },
          "symbol": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "type": "string", "enum": ["function", "class", "interface", "type", "const", "enum", "file"] },
          "inclusionReason": { "type": "string", "enum": ["TARGET", "DIRECT_TEST", "DIRECT_DEPENDENCY", "MODULE_INTERFACE", "ARCHITECTURE_CONTRACT", "BROAD_GOVERNANCE"] },
          "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "signatures": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 16 },
          "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxItems": 32 },
          "tests": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 }, "maxItems": 32 },
          "invariants": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 }, "maxItems": 16 },
          "fallback": { "type": "boolean" },
          "excerpt": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "expansions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "reason"],
        "properties": {
          "from": { "type": "string", "enum": ["C0", "C1", "C2", "C3", "C4"] },
          "to": { "type": "string", "enum": ["C0", "C1", "C2", "C3", "C4"] },
          "reason": { "type": "string", "enum": ["DIRECT_DEP_REQUIRED", "INTERFACE_REQUIRED", "ARCHITECTURE_CONTRACT_REQUIRED", "SOURCE_CONFLICT_INVESTIGATION", "TEST_COVERAGE_REQUIRED"] }
        }
      }
    },
    "sliceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
