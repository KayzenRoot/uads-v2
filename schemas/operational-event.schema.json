{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/operational-event.schema.json",
  "title": "UADS Operational Event",
  "description": "Closed, versioned, privacy-safe operational event transported by M30.",
  "$defs": {
    "payloadValue": {
      "anyOf": [
        { "type": "string", "maxLength": 1000 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "$ref": "#/$defs/payloadValue" }
        },
        {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/payloadValue" }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "eventId",
    "eventHash",
    "projectId",
    "correlationId",
    "workOrderId",
    "executionRunId",
    "reviewId",
    "eventType",
    "sourceComponent",
    "severity",
    "operationalState",
    "occurredAt",
    "recordedAt"
  ],
  "properties": {
    "schema": { "const": "uads.operational-event" },
    "schemaVersion": { "const": "1.0.0" },
    "eventId": { "type": "string", "format": "uuid" },
    "eventHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "workOrderId": { "type": ["string", "null"], "maxLength": 160 },
    "executionRunId": { "type": ["string", "null"], "maxLength": 160 },
    "reviewId": { "type": ["string", "null"], "maxLength": 160 },
    "eventType": {
      "type": "string",
      "enum": [
        "operation.activity",
        "system.health",
        "system.error",
        "system.diagnostic",
        "execution.lifecycle",
        "review.lifecycle",
        "review.analysis",
        "evidence.lifecycle"
      ]
    },
    "sourceComponent": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "severity": { "type": "string", "enum": ["debug", "info", "warn", "error", "critical"] },
    "operationalState": { "type": ["string", "null"], "enum": ["HEALTHY", "DEGRADED", "UNAVAILABLE", null] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "message": { "type": "string", "maxLength": 1000 },
    "gate": { "type": "string", "minLength": 1, "maxLength": 160 },
    "normalizedSubjectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?!\\\\\\\\)(?!/)[^\\u0000]+$"
    },
    "normalizedFindingCode": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": { "$ref": "#/$defs/payloadValue" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "review.analysis" } }, "required": ["eventType"] },
      "then": { "required": ["gate", "normalizedSubjectPath", "normalizedFindingCode", "evidenceDigest"] }
    }
  ]
}
