{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/index-state.schema.json",
  "title": "UADS Index State",
  "description": "Incremental repository intelligence index identity. schemaVersion 0.4.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "projectId",
    "indexDigest",
    "extractorVersion",
    "engineVersion",
    "generatedAt",
    "updatedAt",
    "gitHead",
    "dirtyDigest",
    "gitAvailable",
    "mode",
    "confidence",
    "stale",
    "staleReason",
    "filesConsidered",
    "filesParsed",
    "filesReused",
    "filesRemoved",
    "durationMs",
    "unresolvedCount",
    "nodeCount",
    "edgeCount",
    "complete",
    "truncated",
    "truncationReason",
    "files"
  ],
  "properties": {
    "schema": { "const": "uads.index-state" },
    "schemaVersion": { "const": "0.4.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "indexDigest": { "type": "string", "minLength": 1 },
    "extractorVersion": { "type": "string" },
    "engineVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "gitHead": { "type": ["string", "null"] },
    "dirtyDigest": { "type": "string" },
    "gitAvailable": { "type": "boolean" },
    "mode": { "type": "string", "enum": ["fullBuild", "incrementalUpdate", "reused"] },
    "confidence": { "type": "string", "enum": ["high", "reduced"] },
    "stale": { "type": "boolean" },
    "staleReason": { "type": ["string", "null"] },
    "filesConsidered": { "type": "integer", "minimum": 0 },
    "filesParsed": { "type": "integer", "minimum": 0 },
    "filesReused": { "type": "integer", "minimum": 0 },
    "filesRemoved": { "type": "integer", "minimum": 0 },
    "durationMs": { "type": "integer", "minimum": 0 },
    "unresolvedCount": { "type": "integer", "minimum": 0 },
    "nodeCount": { "type": "integer", "minimum": 0 },
    "edgeCount": { "type": "integer", "minimum": 0 },
    "complete": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "truncationReason": { "type": ["string", "null"] },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contentDigest", "kind", "language", "bytes", "hasExportBoundary"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "contentDigest": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["source", "test", "schema", "config", "docs", "manifest", "binary"] },
          "language": { "type": ["string", "null"] },
          "bytes": { "type": "integer", "minimum": 0 },
          "hasExportBoundary": { "type": "boolean" }
        }
      }
    }
  }
}
