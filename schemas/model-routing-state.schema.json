{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/model-routing-state.schema.json",
  "title": "UADS Model Routing State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "projectId", "mode", "locked", "lockRevision", "updatedAt", "registryDigest", "stateDigest"],
  "properties": {
    "schema": { "const": "uads.model-routing-state" },
    "schemaVersion": { "const": "0.1.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["MODEL_LOCK", "CHEAPEST_QUALIFIED", "QUALITY_FLOOR_AUTOROUTE"] },
    "locked": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["profileId", "providerId", "modelId"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "providerId": { "type": "string", "minLength": 1 },
        "modelId": { "type": "string", "minLength": 1 }
      }
    },
    "lockRevision": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "registryDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "stateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
