{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/cache-decision.schema.json",
  "title": "UADS Cache Decision",
  "description": "Explainable evidence-cache decision. schemaVersion 0.6.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "cacheDecisionId",
    "projectId",
    "workOrderId",
    "executionRunId",
    "gateId",
    "candidateCacheRecordId",
    "decision",
    "reasonCodes",
    "changedValidityInputs",
    "executionRequired",
    "maySatisfyGate",
    "liveChangeDigest",
    "indexDigest",
    "createdAt"
  ],
  "properties": {
    "schema": { "const": "uads.cache-decision" },
    "schemaVersion": { "const": "0.6.0" },
    "cacheDecisionId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "workOrderId": { "type": ["string", "null"] },
    "executionRunId": { "type": ["string", "null"] },
    "gateId": { "type": "string", "minLength": 1 },
    "candidateCacheRecordId": { "type": ["string", "null"] },
    "decision": { "type": "string", "enum": ["HIT", "MISS", "STALE", "NOT_REUSABLE", "BLOCKED"] },
    "reasonCodes": { "type": "array", "items": { "type": "string" } },
    "changedValidityInputs": { "type": "array", "items": { "type": "string" } },
    "executionRequired": { "type": "boolean" },
    "maySatisfyGate": { "type": "boolean" },
    "liveChangeDigest": { "type": ["string", "null"] },
    "indexDigest": { "type": ["string", "null"] },
    "gateReuseContractIdentity": { "type": ["string", "null"] },
    "reuseProofDigest": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
