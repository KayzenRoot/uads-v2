{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/qpt-snapshot.schema.json",
  "title": "UADS QPT Snapshot",
  "description": "Provider-neutral Quality-per-Token estimate. schemaVersion 0.6.0. Not financial cost.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "projectId",
    "requiredGatesTotal",
    "requiredGatesSatisfiedCurrent",
    "verifiedQualityCoverage",
    "requiredIndependentReview",
    "estimatedContextTokens",
    "tokenEstimateMethod",
    "toolExecutions",
    "gateExecutions",
    "gateCacheHits",
    "gateCacheMisses",
    "avoidedWorkCount",
    "contextRadius",
    "budgetUtilization",
    "qptRatio",
    "qptFormula",
    "limitations",
    "updatedAt"
  ],
  "properties": {
    "schema": { "const": "uads.qpt-snapshot" },
    "schemaVersion": { "const": "0.6.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "requiredGatesTotal": { "type": "integer", "minimum": 0 },
    "requiredGatesSatisfiedCurrent": { "type": "integer", "minimum": 0 },
    "verifiedQualityCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "requiredIndependentReview": { "type": "string", "enum": ["pending", "satisfied", "not-required"] },
    "estimatedContextTokens": { "type": "integer", "minimum": 0 },
    "tokenEstimateMethod": { "const": "byte-heuristic" },
    "toolExecutions": { "type": "integer", "minimum": 0 },
    "gateExecutions": { "type": "integer", "minimum": 0 },
    "gateCacheHits": { "type": "integer", "minimum": 0 },
    "gateCacheMisses": { "type": "integer", "minimum": 0 },
    "avoidedWorkCount": { "type": "integer", "minimum": 0 },
    "contextRadius": { "type": ["string", "null"] },
    "budgetUtilization": { "type": ["number", "null"] },
    "qptRatio": { "type": "number" },
    "qptFormula": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "estimatedDiagnosticTokens": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
