{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/specialist-registry.schema.json",
  "title": "UADS Specialist Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "profiles", "registryDigest", "policyVersion"],
  "properties": {
    "schema": { "const": "uads.specialist-registry" },
    "schemaVersion": { "const": "0.9.0" },
    "profiles": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "specialist-profile.schema.json" } },
    "registryDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policyVersion": { "const": "0.9.0" }
  }
}
