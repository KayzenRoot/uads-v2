{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KayzenRoot/uads/schemas/release-manifest.schema.json",
  "title": "UADS release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "version", "tag", "commit", "generatedAt", "artifacts", "validationReport", "ciBinding"],
  "properties": {
    "schema": { "const": "uads.release-manifest" },
    "schemaVersion": { "enum": ["0.7.0", "0.7.1", "0.8.0", "0.8.1", "0.9.0", "0.9.1", "0.10.0", "0.11.0", "0.11.1"] },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "tag": { "type": "string", "pattern": "^v" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": { "type": "string", "pattern": "^[^\\\\/:][^\\\\:]*$" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "validationReport": { "type": "string", "minLength": 1 },
    "ciBinding": { "type": ["string", "null"], "not": { "pattern": "^(tmp|\\.tmp|release)(/|\\\\)" } }
  }
}
