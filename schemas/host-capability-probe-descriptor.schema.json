{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.local/schemas/host-capability-probe-descriptor.schema.json",
  "title": "UADS Host Capability Probe Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema","schemaVersion","probeId","purpose","availability","capabilityId",
    "executableRule","fixedArgs","sideEffectClass","networkPolicy","timeoutMs",
    "maxStdoutBytes","maxStderrBytes","envAllowlist","parserId",
    "supportedPlatforms","descriptorDigest"
  ],
  "properties": {
    "schema": { "const": "uads.host-capability-probe-descriptor" },
    "schemaVersion": { "const": "1.0.0" },
    "probeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
    "availability": { "enum": ["PRODUCTION","TEST_ONLY"] },
    "capabilityId": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["modelSelection","toolCalling","structuredOutput","promptCache","explicitCache","persistentContext","subagents","parallelAgents","usageTelemetry","visionInput"] }
      ]
    },
    "executableRule": { "const": "node-current" },
    "fixedArgs": {
      "type": "array","maxItems": 16,
      "items": { "type": "string", "maxLength": 512 }
    },
    "sideEffectClass": { "enum": ["READ_ONLY_LOCAL","TEMPORARY_LOCAL","NETWORK_OBSERVE","MUTATING","COST_BEARING"] },
    "networkPolicy": { "enum": ["DENY","OBSERVE"] },
    "timeoutMs": { "type": "integer", "minimum": 10, "maximum": 5000 },
    "maxStdoutBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "maxStderrBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
    "envAllowlist": {
      "type": "array","maxItems": 9,"uniqueItems": true,
      "items": { "enum": ["SystemRoot","WINDIR","TEMP","TMP","TMPDIR","HOME","USERPROFILE","LANG","LC_ALL"] }
    },
    "parserId": { "enum": ["node-version-v1","exit-code-v1","echo-safe-v1"] },
    "supportedPlatforms": {
      "type": "array","minItems": 1,"maxItems": 3,"uniqueItems": true,
      "items": { "enum": ["linux","win32","darwin"] }
    },
    "descriptorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
