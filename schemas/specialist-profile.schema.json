{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/specialist-profile.schema.json",
  "title": "UADS Specialist Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "specialistId", "kind", "status", "purpose", "coveredDomains", "functions", "mayImplement", "reviewOnly", "independenceClass", "activation", "requiredInputs", "producesEvidence", "incompatibleWith", "priority", "source", "notes", "profileDigest"],
  "properties": {
    "schema": { "const": "uads.specialist-profile" },
    "schemaVersion": { "const": "0.9.0" },
    "specialistId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "kind": { "enum": ["core", "domain", "assurance"] },
    "status": { "enum": ["enabled", "disabled", "experimental"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
    "coveredDomains": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "enum": ["general", "requirements", "architecture", "frontend", "backend", "api", "database", "saas", "mobile", "cloud-devops", "security", "quality", "performance", "reliability", "data-ai", "web3", "smart-contracts", "wallets", "finance-economics", "tokenomics", "mathematics-simulation", "game-systems", "documentation", "release"] } },
    "functions": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "enum": ["inspect", "requirements", "architecture", "planning", "implementation", "testing", "independent-review", "security-assurance", "performance-assurance", "reliability-assurance", "checkpoint", "frontend", "backend-api", "database", "mobile", "platform-cloud", "data-ai", "web3-contract", "finance-math", "game-systems", "documentation", "release", "quality"] } },
    "mayImplement": { "type": "boolean" },
    "reviewOnly": { "type": "boolean" },
    "independenceClass": { "enum": ["implementation", "support", "independent-review", "assurance"] },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopeClasses": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "enum": ["trivial", "local", "cross-cutting", "architectural"] } },
        "minRisk": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "domainAny": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "riskSignalsAny": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 96 } },
        "gatesAny": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 96 } },
        "affectedAreaAny": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 96 } }
      }
    },
    "requiredInputs": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "producesEvidence": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
    "incompatibleWith": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } },
    "priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "source": { "enum": ["builtin", "user-config", "adapter"] },
    "notes": { "type": ["string", "null"], "maxLength": 1000 },
    "profileDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
