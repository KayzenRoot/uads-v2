{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/evidence-cache-record.schema.json",
  "title": "UADS Evidence Cache Record",
  "description": "Reusable PASS evidence identity. schemaVersion 0.6.0. No raw command output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "cacheRecordId",
    "projectId",
    "originatingWorkOrderId",
    "originatingExecutionRunId",
    "gateId",
    "evidenceId",
    "evidenceStatus",
    "evidenceKind",
    "originatingChangeDigest",
    "command",
    "gateReuseContractIdentity",
    "reuseProofDigest",
    "toolIdentity",
    "environmentIdentity",
    "validityBasisPaths",
    "validityBasisDigests",
    "manifestDigests",
    "indexDigest",
    "policyIdentity",
    "outputDigest",
    "fileDigest",
    "createdAt",
    "reuseClass",
    "reusable",
    "status",
    "invalidationReason"
  ],
  "properties": {
    "schema": { "const": "uads.evidence-cache-record" },
    "schemaVersion": { "const": "0.6.0" },
    "cacheRecordId": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "originatingWorkOrderId": { "type": "string", "minLength": 1 },
    "originatingExecutionRunId": { "type": "string", "minLength": 1 },
    "gateId": { "type": "string", "minLength": 1 },
    "evidenceId": { "type": "string", "minLength": 1 },
    "evidenceStatus": { "const": "PASS" },
    "evidenceKind": { "type": "string", "enum": ["command", "file", "invariant"] },
    "originatingChangeDigest": { "type": "string", "minLength": 1 },
    "command": { "type": ["string", "null"] },
    "gateReuseContractIdentity": { "type": "string", "minLength": 1 },
    "reuseProofDigest": { "type": "string", "minLength": 1 },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "environmentIdentity": { "type": ["string", "null"] },
    "validityBasisPaths": { "type": "array", "items": { "type": "string" } },
    "validityBasisDigests": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "manifestDigests": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "indexDigest": { "type": "string" },
    "policyIdentity": { "type": "string" },
    "outputDigest": { "type": ["string", "null"] },
    "fileDigest": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "reuseClass": { "type": "string", "enum": ["eligible", "not-reusable"] },
    "reusable": { "type": "boolean" },
    "status": { "type": "string", "enum": ["reusable", "stale", "historical", "not-reusable"] },
    "invalidationReason": { "type": ["string", "null"] }
  }
}
