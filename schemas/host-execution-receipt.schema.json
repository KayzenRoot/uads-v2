{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/host-execution-receipt.schema.json",
  "title": "UADS Host Execution Receipt",
  "description": "Closed, provider-neutral, sidecar-only receipt for one identity-bound host handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "contractVersion",
    "receiptId",
    "handoffId",
    "adapterId",
    "adapterContractVersion",
    "projectId",
    "bundleId",
    "bundleDigest",
    "workOrderId",
    "workOrderDigest",
    "routingDecisionId",
    "routingDecisionDigest",
    "specialistSelectionPlanId",
    "specialistSelectionDigest",
    "modelPlanId",
    "modelPlanDigest",
    "modelRuntimeIdentityDigest",
    "runtimeId",
    "runtimeIdentityDigest",
    "executionRunId",
    "hostTargetRootDigest",
    "currentChangeDigest",
    "state",
    "reasonCodes",
    "createdAt",
    "updatedAt",
    "acceptedAt",
    "startedAt",
    "completedAt",
    "receiptDigest"
  ],
  "properties": {
    "schema": { "const": "uads.host-execution-receipt" },
    "schemaVersion": { "const": "0.1.0" },
    "contractVersion": { "const": "0.1.0" },
    "receiptId": { "type": "string", "pattern": "^her_[a-f0-9]{16}$" },
    "handoffId": { "type": "string", "pattern": "^heh_[a-f0-9]{16}$" },
    "adapterId": { "type": "string", "enum": ["cursor", "codex", "generic-agent-skills"] },
    "adapterContractVersion": { "type": "string", "const": "0.10.0" },
    "projectId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "bundleId": { "type": "string", "pattern": "^hdb_[a-f0-9]{16}$" },
    "bundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "workOrderId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "workOrderDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "routingDecisionId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "routingDecisionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "specialistSelectionPlanId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "specialistSelectionDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelPlanId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._-]+$" },
    "modelPlanDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "modelRuntimeIdentityDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "runtimeId": { "type": ["string", "null"], "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "runtimeIdentityDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "executionRunId": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9._-]+$" },
    "hostTargetRootDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentChangeDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "state": { "type": "string", "enum": ["ACCEPTED", "STARTED", "COMPLETED", "FAILED", "BLOCKED"] },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "HANDOFF_ACCEPTED",
          "HANDOFF_STARTED",
          "HANDOFF_COMPLETED",
          "HANDOFF_FAILED",
          "HANDOFF_BLOCKED",
          "BUNDLE_MISSING",
          "BUNDLE_CORRUPT",
          "BUNDLE_DIGEST_MISMATCH",
          "BUNDLE_STALE",
          "PROJECT_MISMATCH",
          "ADAPTER_MISMATCH",
          "TARGET_ROOT_MISMATCH",
          "OWNERSHIP_NOT_TRUSTED",
          "EXECUTION_RUN_MISSING",
          "EXECUTION_RUN_MISMATCH",
          "CHANGE_IDENTITY_MISMATCH",
          "MODEL_PLAN_BLOCKED",
          "SPECIALIST_SELECTION_INVALID",
          "HOST_CAPABILITY_UNPROVEN",
          "HOST_CAPABILITY_INSUFFICIENT",
          "APPROVAL_AUTHORIZATION_MISSING",
          "HANDOFF_REPLAY",
          "RECEIPT_CORRUPT",
          "RECEIPT_DIGEST_MISMATCH",
          "INVALID_TRANSITION",
          "TERMINAL_IMMUTABLE",
          "RECEIPT_NOT_GATE_EVIDENCE"
        ]
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "acceptedAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "receiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
