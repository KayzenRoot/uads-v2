{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KayzenRoot/uads/schemas/host-dispatch-bundle.schema.json",
  "title": "UADS host dispatch bundle",
  "description": "Provider-neutral, identity-bound host handoff prepared from current UADS artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "bundleId",
    "adapterId",
    "adapterContractVersion",
    "adapterDetectionStatus",
    "adapterVersion",
    "projectId",
    "workOrderId",
    "routingDecisionId",
    "executionRunId",
    "workOrderDigest",
    "routingDecisionDigest",
    "specialistSelectionPlanId",
    "specialistSelectionDigest",
    "specialistRegistryDigest",
    "specialistPolicyDigest",
    "specialistGateContractDigest",
    "specialistChangeDigest",
    "specialistImpactDigest",
    "modelPlanId",
    "modelPlanDigest",
    "modelRuntimeIdentityDigest",
    "modelRegistryDigest",
    "modelPolicyDigest",
    "runtimeId",
    "runtimeIdentityDigest",
    "hostTargetRootDigest",
    "hostCapabilities",
    "contextPackId",
    "impactReportId",
    "indexDigest",
    "currentChangeDigest",
    "riskLevel",
    "scopeClass",
    "capabilityClass",
    "contextRadius",
    "includedScope",
    "outOfScope",
    "selectedGates",
    "requiredEvidence",
    "requiredAssuranceRoles",
    "dependencyGroups",
    "parallelEligibleGroups",
    "execution",
    "limits",
    "assignments",
    "status",
    "bundleDigest"
  ],
  "properties": {
    "schema": { "const": "uads.host-dispatch-bundle" },
    "schemaVersion": { "const": "0.10.0" },
    "bundleId": { "type": "string", "pattern": "^hdb_[a-f0-9]{16}$" },
    "adapterId": { "enum": ["cursor", "codex", "generic-agent-skills"] },
    "adapterContractVersion": { "const": "0.10.0" },
    "adapterDetectionStatus": { "enum": ["SUPPORTED", "UNAVAILABLE", "UNPROVEN", "BLOCKED"] },
    "adapterVersion": { "type": ["string", "null"], "maxLength": 64 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "workOrderId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "routingDecisionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "executionRunId": { "type": ["string", "null"], "maxLength": 128 },
    "workOrderDigest": { "$ref": "#/$defs/digest" },
    "routingDecisionDigest": { "$ref": "#/$defs/digest" },
    "specialistSelectionPlanId": { "type": "string", "pattern": "^sp_[a-f0-9]{16}$" },
    "specialistSelectionDigest": { "$ref": "#/$defs/digest" },
    "specialistRegistryDigest": { "$ref": "#/$defs/digest" },
    "specialistPolicyDigest": { "$ref": "#/$defs/digest" },
    "specialistGateContractDigest": { "$ref": "#/$defs/digestOrNull" },
    "specialistChangeDigest": { "$ref": "#/$defs/digestOrNull" },
    "specialistImpactDigest": { "$ref": "#/$defs/digestOrNull" },
    "modelPlanId": { "type": ["string", "null"], "maxLength": 128 },
    "modelPlanDigest": { "$ref": "#/$defs/digestOrNull" },
    "modelRuntimeIdentityDigest": { "$ref": "#/$defs/digestOrNull" },
    "modelRegistryDigest": { "$ref": "#/$defs/digestOrNull" },
    "modelPolicyDigest": { "$ref": "#/$defs/digestOrNull" },
    "runtimeId": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,127}$" },
    "runtimeIdentityDigest": { "$ref": "#/$defs/digest" },
    "hostTargetRootDigest": { "$ref": "#/$defs/digest" },
    "hostCapabilities": { "$ref": "#/$defs/capabilities" },
    "contextPackId": { "type": ["string", "null"], "maxLength": 128 },
    "impactReportId": { "type": ["string", "null"], "maxLength": 128 },
    "indexDigest": { "$ref": "#/$defs/digestOrNull" },
    "currentChangeDigest": { "$ref": "#/$defs/digestOrNull" },
    "activeApprovalGatedActions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "production deployment",
          "destructive production database operation",
          "spending money / material-cost external infrastructure action",
          "rotating real credentials",
          "destructive Git history rewrite",
          "publishing package/release when not already authorized",
          "transferring assets/funds",
          "on-chain transaction execution"
        ]
      }
    },
    "activeApprovalIntentAmbiguous": { "type": "boolean" },
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "scopeClass": { "enum": ["trivial", "local", "cross-cutting", "architectural"] },
    "capabilityClass": { "enum": ["economy", "balanced", "strong", "critical"] },
    "contextRadius": { "enum": ["C0", "C1", "C2", "C3", "C4", "C5"] },
    "includedScope": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 240 } },
    "outOfScope": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 240 } },
    "selectedGates": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 96 } },
    "requiredEvidence": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 160 } },
    "requiredAssuranceRoles": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" } },
    "dependencyGroups": { "type": "array", "maxItems": 32, "items": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/specialistId" } } },
    "parallelEligibleGroups": { "type": "array", "maxItems": 32, "items": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/specialistId" } } },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parallel", "roleDispatch", "reasonCodes"],
      "properties": {
        "parallel": { "type": "boolean" },
        "roleDispatch": { "enum": ["subagents", "role-cycling"] },
        "reasonCodes": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_:-]{1,120}$" } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenSoftLimit", "tokenHardLimit", "contextRadius"],
      "properties": {
        "tokenSoftLimit": { "type": "integer", "minimum": 0 },
        "tokenHardLimit": { "type": "integer", "minimum": 0 },
        "contextRadius": { "enum": ["C0", "C1", "C2", "C3", "C4", "C5"] }
      }
    },
    "assignments": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/assignment" } },
    "status": { "const": "PREPARED" },
    "bundleDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digestOrNull": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "specialistId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,95}$" },
    "capability": { "type": ["boolean", "string"], "enum": [true, false, "unknown"] },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelSelection", "toolCalling", "structuredOutput", "promptCache", "explicitCache", "persistentContext", "subagents", "parallelAgents", "usageTelemetry", "visionInput"],
      "properties": {
        "modelSelection": { "$ref": "#/$defs/capability" },
        "toolCalling": { "$ref": "#/$defs/capability" },
        "structuredOutput": { "$ref": "#/$defs/capability" },
        "promptCache": { "$ref": "#/$defs/capability" },
        "explicitCache": { "$ref": "#/$defs/capability" },
        "persistentContext": { "$ref": "#/$defs/capability" },
        "subagents": { "$ref": "#/$defs/capability" },
        "parallelAgents": { "$ref": "#/$defs/capability" },
        "usageTelemetry": { "$ref": "#/$defs/capability" },
        "visionInput": { "$ref": "#/$defs/capability" }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialistId", "role", "objective", "necessaryScope", "forbiddenScope", "relevantFiles", "affectedAreas", "gates", "evidenceObligations", "riskLevel", "dependencyGroup", "parallelEligible", "requiredPredecessorRoles", "contextReferences"],
      "properties": {
        "specialistId": { "$ref": "#/$defs/specialistId" },
        "role": { "type": "string", "minLength": 1, "maxLength": 240 },
        "objective": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "necessaryScope": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 240 } },
        "forbiddenScope": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 240 } },
        "relevantFiles": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 240 } },
        "affectedAreas": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 240 } },
        "gates": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 96 } },
        "evidenceObligations": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 160 } },
        "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "dependencyGroup": { "type": "integer", "minimum": 1, "maximum": 8 },
        "parallelEligible": { "type": "boolean" },
        "requiredPredecessorRoles": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/specialistId" } },
        "contextReferences": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 240, "pattern": "^[a-z0-9:/._-]+$" } }
      }
    }
  }
}
