{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/cost-ledger.schema.json",
  "title": "UADS Cost Ledger",
  "description": "Provider-neutral observed/estimated counters. schemaVersion 0.6.0. Not billing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "projectId",
    "workOrderId",
    "executionRunId",
    "estimatedContextTokens",
    "estimatedDiagnosticTokens",
    "contextExpansions",
    "c5Uses",
    "toolExecutions",
    "gateExecutions",
    "gateCacheHits",
    "gateCacheMisses",
    "evidenceReuseCount",
    "avoidedToolExecutions",
    "fullRepositoryScans",
    "agentCallsReported",
    "modelCapabilityClass",
    "softBudget",
    "hardBudget",
    "budgetStatus",
    "tokenEstimateMethod",
    "updatedAt"
  ],
  "properties": {
    "schema": { "const": "uads.cost-ledger" },
    "schemaVersion": { "const": "0.6.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "workOrderId": { "type": ["string", "null"] },
    "executionRunId": { "type": ["string", "null"] },
    "estimatedContextTokens": { "type": "integer", "minimum": 0 },
    "estimatedDiagnosticTokens": { "type": "integer", "minimum": 0 },
    "contextExpansions": { "type": "integer", "minimum": 0 },
    "c5Uses": { "type": "integer", "minimum": 0 },
    "toolExecutions": { "type": "integer", "minimum": 0 },
    "gateExecutions": { "type": "integer", "minimum": 0 },
    "gateCacheHits": { "type": "integer", "minimum": 0 },
    "gateCacheMisses": { "type": "integer", "minimum": 0 },
    "evidenceReuseCount": { "type": "integer", "minimum": 0 },
    "avoidedToolExecutions": { "type": "integer", "minimum": 0 },
    "fullRepositoryScans": { "type": "integer", "minimum": 0 },
    "agentCallsReported": { "type": ["integer", "null"], "minimum": 0 },
    "modelCapabilityClass": { "type": ["string", "null"] },
    "softBudget": { "type": ["integer", "null"], "minimum": 0 },
    "hardBudget": { "type": ["integer", "null"], "minimum": 0 },
    "budgetStatus": { "type": "string", "enum": ["ok", "soft-warning", "hard-blocked"] },
    "tokenEstimateMethod": { "const": "byte-heuristic" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
