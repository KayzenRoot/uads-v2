{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/correction-delta.schema.json",
  "title": "Engineering Correction Delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "workOrderId", "status", "baselineGitSha", "problem", "rootCause", "changes", "verification"],
  "properties": {
    "schema": { "const": "uads.engineering-correction-delta" },
    "schemaVersion": { "const": "1.0.0" },
    "workOrderId": { "type": "string", "pattern": "^ENG-[A-Z0-9-]+-[0-9]{3}$" },
    "status": { "type": "string", "enum": ["NOT_REQUIRED", "PROPOSED", "APPLIED", "BLOCKED"] },
    "baselineGitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "problem": { "type": "string" },
    "rootCause": { "type": "string" },
    "changes": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "remainingRisks": { "type": "array", "items": { "type": "string" } }
  }
}
