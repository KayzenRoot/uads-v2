{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/engineering-work-order.schema.json",
  "title": "UADS Engineering Delivery Work Order",
  "description": "Static repository-governance Work Order. This is not the UADS runtime sidecar Work Order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "workOrderId", "repository", "branch", "baselineGitSha", "status", "objective", "includedScope", "outOfScope", "acceptanceCriteria", "requiredEvidence", "stopConditions"],
  "properties": {
    "schema": { "const": "uads.engineering-work-order" },
    "schemaVersion": { "const": "1.0.0" },
    "workOrderId": { "type": "string", "pattern": "^ENG-[A-Z0-9-]+-[0-9]{3}$" },
    "repository": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "branch": { "type": "string", "pattern": "^(chore|fix|docs|test|feat)/[a-z0-9-]+$" },
    "baselineGitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "headGitSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "status": { "type": "string", "enum": ["PROPOSED", "ACTIVE", "READY_FOR_REVIEW", "COMPLETED", "BLOCKED", "CANCELLED"] },
    "scopeClass": { "type": "string", "enum": ["trivial", "local", "cross-cutting", "architectural"] },
    "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "objective": { "type": "string", "minLength": 1 },
    "includedScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "outOfScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "stopConditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "selectedGates": { "type": "array", "items": { "type": "string" } },
    "reviewers": { "type": "array", "items": { "type": "string" } },
    "autonomyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safeAutonomous", "requiresApproval"],
      "properties": {
        "safeAutonomous": { "type": "array", "items": { "type": "string" } },
        "requiresApproval": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
