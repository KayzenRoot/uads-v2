{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uads.dev/schemas/evidence-bundle.schema.json",
  "title": "Engineering Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "evidenceId", "workOrderId", "repository", "baselineGitSha", "status", "claims"],
  "properties": {
    "schema": { "const": "uads.engineering-evidence-bundle" },
    "schemaVersion": { "const": "1.0.0" },
    "evidenceId": { "type": "string", "pattern": "^ENG-[A-Z0-9-]+-[0-9]{3}$" },
    "workOrderId": { "type": "string", "pattern": "^ENG-[A-Z0-9-]+-[0-9]{3}$" },
    "repository": { "type": "string" },
    "baselineGitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "headGitSha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "status": { "type": "string", "enum": ["DRAFT", "PARTIAL", "COMPLETE", "BLOCKED"] },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "kind", "reference", "status"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["command", "output", "file", "test", "review", "github"] },
          "reference": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "NOT_CONFIGURED", "UNKNOWN", "SKIPPED"] },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
